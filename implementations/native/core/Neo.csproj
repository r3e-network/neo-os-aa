<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Neo</AssemblyName>
    <RootNamespace>Neo</RootNamespace>
    <VersionPrefix>3.10.2</VersionPrefix>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>false</IsPackable>
    <NeoCoreRoot Condition="'$(NeoCoreRoot)' == ''">$(MSBuildThisFileDirectory)../../../../neo-native-core/src/Neo</NeoCoreRoot>
    <NeoSourceRoot Condition="'$(NeoSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../../../neo-native-core/src</NeoSourceRoot>
  </PropertyGroup>

  <!-- The overlay consumes the pinned native core exclusively: every source
       file (including the canonical SmartAccount native contract and its
       runtime dispatch) is compiled straight out of $(NeoCoreRoot), so the
       core repository stays the single source of truth and this project is a
       thin, fork-free build wrapper. Both roots are regular MSBuild
       properties and can be overridden by environment variables of the same
       name (NeoCoreRoot / NeoSourceRoot). -->
  <ItemGroup>
    <Compile Include="$(NeoCoreRoot)/**/*.cs"
             Exclude="$(NeoCoreRoot)/obj/**;$(NeoCoreRoot)/bin/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The core wordlist resources live outside this project directory, so the
         manifest resource name must be pinned explicitly to the name the core's
         generated Resources.Designer.cs looks up (Neo.Properties.Resources). -->
    <EmbeddedResource Include="$(NeoCoreRoot)/Properties/Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <LogicalName>Neo.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
    <None Include="$(NeoCoreRoot)/Resources/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.70" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.21.0" />
    <PackageReference Include="Neo.Cryptography.BLS12_381" Version="3.9.0" />
    <PackageReference Include="Neo.VM" Version="[3.10.2-CI00390]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(NeoSourceRoot)/Neo.Extensions/Neo.Extensions.csproj" />
    <ProjectReference Include="$(NeoSourceRoot)/Neo.IO/Neo.IO.csproj" />
    <ProjectReference Include="$(NeoSourceRoot)/Neo.Json/Neo.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Neo.UnitTests" />
    <InternalsVisibleTo Include="Neo.SmartContract.Testing" />
    <InternalsVisibleTo Include="Neo.SmartContract.TestEngine" />
    <InternalsVisibleTo Include="Neo.Plugins.RpcServer.Tests" />
    <InternalsVisibleTo Include="Neo.Plugins.OracleService.Tests" />
    <InternalsVisibleTo Include="neodebug-3-adapter" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
