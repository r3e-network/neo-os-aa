  ],
  "artifactRoots": [
    "contracts/build",
    "docs/reports"
  ],
  "verification": {
    "profile": "native",
    "commands": [
      "./scripts/verify_repo.sh --profile native --contracts-only",
      "cd frontend && npm run test:native:browser"
    ]
