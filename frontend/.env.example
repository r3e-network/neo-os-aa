# Browser-safe runtime values
# Contract hashes, NNS domains and Morpheus URLs below override the generated
# Morpheus registry (src/config/generatedMorpheusRegistry.js, synced from
# neo-os-services by scripts/sync_morpheus_registry.mjs). Leave a key empty to use
# the registry value for VITE_AA_NETWORK; tests/runtimeConfig.test.js checks every
# registry-backed value set here against the registry.
VITE_AA_NETWORK=mainnet
VITE_AA_HASH=0x0268a387913b250166ddec032b03332690a1ef78
VITE_AA_DOMAIN=morpheus-aa.miniapp.neo
VITE_AA_RPC_URL=https://mainnet1.neo.coz.io:443
# Optional override for the Neo N3 network magic baked into V3 UserOperation
# signatures. Defaults to the magic of VITE_AA_NETWORK (mainnet 860833102,
# testnet 894710606); only set this for a custom/private network.
VITE_AA_NETWORK_MAGIC=860833102
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_AA_RELAY_URL=/api/relay-transaction
VITE_AA_RELAY_RPC_URL=https://mainnet1.neo.coz.io:443
VITE_AA_RELAY_META_ENABLED=1
VITE_AA_RELAY_RAW_ENABLED=0
VITE_AA_EXPLORER_BASE_URL=https://neotube.io/tx/
VITE_AA_MATRIX_CONTRACT_HASH=0x994c3cbe0d8641b9c911452c37191de8dd9f5f4e
VITE_AA_MARKET_HASH=0xae7afe3a85ab08bfd1d4907b35ae8b80c75b3a69
VITE_AA_PAYMASTER_HASH=0xa0defa2bc6d7a71ba1e237149287c8ca4ff46caf
# AA wallet account discovery reads this host, and only this host. It has no
# compiled-in default: leave it empty and discovery refuses instead of reading
# the public production API.
#
# Set it to the origin that serves the read API UNDER /indexer: the edge or
# reverse-proxy origin the browser uses. The client always appends
# /indexer/v1/networks/..., and the edge strips that prefix before the read API
# sees it. In the CU-95 local-stack acceptance that origin was the local edge on
# http://127.0.0.1:41296, in front of the read API listener on
# http://127.0.0.1:41295. Pointing this setting at the read API's own listener
# instead makes both discovery routes 404, because that listener serves
# /v1/networks/... and has no /indexer path.
VITE_AA_N3INDEX_API_BASE_URL=
VITE_AA_N3INDEX_NETWORK=mainnet
VITE_WEB3AUTH_CLIENT_ID=
VITE_WEB3AUTH_PROJECT_NAME=DID.Morpheus
VITE_WEB3AUTH_NETWORK=sapphire_mainnet
VITE_WEB3AUTH_CHAIN_NAMESPACE=eip155
VITE_WEB3AUTH_CHAIN_ID=0x1
VITE_WEB3AUTH_RPC_TARGET=https://rpc.ankr.com/eth
VITE_WEB3AUTH_REDIRECT_URL=
VITE_WEB3AUTH_EMAIL_LOGIN_ENABLED=1
VITE_WEB3AUTH_SMS_LOGIN_ENABLED=1
VITE_NEODID_PROVIDER=web3auth
VITE_NEODID_DOMAIN=morpheus-neodid.miniapp.neo
VITE_MORPHEUS_RUNTIME_URL=https://oracle.meshmini.app/mainnet
VITE_MORPHEUS_TESTNET_RUNTIME_URL=https://oracle.meshmini.app/testnet
VITE_MORPHEUS_EDGE_BASE_URL=https://edge.meshmini.app
VITE_MORPHEUS_CONTROL_PLANE_BASE_URL=https://control.meshmini.app
VITE_MORPHEUS_API_BASE_URL=https://oracle.meshmini.app/mainnet
VITE_MORPHEUS_NEODID_SERVICE_DID=did:morpheus:neo_n3:service:neodid
VITE_DID_VERIFICATION_ENDPOINT=/api/did-verify
VITE_DID_NOTIFICATION_ENDPOINT=/api/did-notify
VITE_MORPHEUS_NEODID_ENDPOINT=/api/morpheus-neodid
VITE_MORPHEUS_NEODID_RESOLVE_ENDPOINT=/api/morpheus-neodid?action=resolve
VITE_MORPHEUS_ORACLE_KEY_ENDPOINT=/api/morpheus-oracle-public-key
VITE_DID_NOTIFICATION_EMAIL_ENABLED=1
VITE_DID_NOTIFICATION_SMS_ENABLED=1

# Server-only runtime values for bundled API routes
AA_RELAY_RPC_URL=https://mainnet1.neo.coz.io:443
AA_RELAY_WIF=your-relay-wif
AA_METADATA_API_KEY=
AA_RELAY_ALLOWED_HASH=0x0268a387913b250166ddec032b03332690a1ef78
# Enable only after compatible core deployment and per-account verify-scope readback.
# See docs/AA-PROXY-TRANSFERS.md. Fee ceilings remain mandatory for broadcasts.
AA_RELAY_PROXY_WITNESS_ENABLED=0
# Required when enabled: datoshi reserve for custom witness fees omitted by published Neo RPC.
# Choose and validate against your node, script sizes and configured total/network fee caps.
AA_RELAY_PROXY_NETWORK_FEE_RESERVE=
AA_RELAY_ALLOW_RAW_FORWARD=0
AA_RELAY_INCLUDE_RAW_ERRORS=0
MORPHEUS_NETWORK=mainnet
MORPHEUS_RUNTIME_URL=https://oracle.meshmini.app/mainnet
MORPHEUS_MAINNET_RUNTIME_URL=https://oracle.meshmini.app/mainnet
MORPHEUS_TESTNET_RUNTIME_URL=https://oracle.meshmini.app/testnet
MORPHEUS_RUNTIME_TOKEN=
MORPHEUS_PAYMASTER_TESTNET_ENDPOINT=https://oracle.meshmini.app/testnet/paymaster/authorize
MORPHEUS_PAYMASTER_TESTNET_API_TOKEN=
MORPHEUS_PAYMASTER_MAINNET_ENDPOINT=https://oracle.meshmini.app/mainnet/paymaster/authorize
MORPHEUS_PAYMASTER_MAINNET_API_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DID_EMAIL_WEBHOOK_URL=
DID_EMAIL_WEBHOOK_TOKEN=
DID_SMS_WEBHOOK_URL=
DID_SMS_WEBHOOK_TOKEN=
WEB3AUTH_CLIENT_SECRET=
WEB3AUTH_JWKS_URL=https://api-auth.web3auth.io/.well-known/jwks.json
MORPHEUS_API_BASE_URL=https://oracle.meshmini.app/mainnet
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token-here

# Neon Database (Vercel Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=
