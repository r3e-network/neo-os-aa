{
  "name": "neo-abstract-account-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/r3e-network/neo-os-aa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r3e-network/neo-os-aa.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "audit:prod": "node ../scripts/check_frontend_audit_allowlist.mjs",
    "preview": "vite preview",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:browser": "npm run build && npm run test:e2e:browser:built",
    "test:e2e:browser:built": "node tests/browserSmoke.e2e.mjs",
    "test:operator-recovery:browser": "node --test tests/operatorKeyRecovery.browser.mjs",
    "test:native:browser": "node --test tests/nativeWorkspace.browser.mjs",
    "prebuild": "node scripts/sync-native-shared.mjs",
    "audit:all": "node ../scripts/check_frontend_audit_allowlist.mjs --all",
    "test:web3auth:browser": "node --test tests/web3AuthPackage.browser.mjs",
    "test:docs-security:browser": "node --test tests/docsDependencySecurity.browser.mjs",
    "test:bundle:browser": "node --test tests/deferredIdentityBundle.browser.mjs",
    "test:ordinary:browser": "node --test tests/ordinaryLifecycle.browser.mjs tests/ordinaryMetadata.browser.mjs"
  },
  "dependencies": {
    "@cityofzion/neon-js": "5.9.0",
    "@highlightjs/vue-plugin": "^2.1.0",
    "@supabase/supabase-js": "^2.110.5",
    "@web3auth/modal": "^10.16.0",
    "ethers": "^6.17.0",
    "highlight.js": "^11.11.1",
    "jose": "^6.2.12",
    "marked": "^17.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.6.1",
    "marked-highlight": "2.2.4",
    "mermaid": "^11.16.0",
    "playwright": "^1.58.2",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "overrides": {
    "@cityofzion/neon-api": "5.9.0",
    "@cityofzion/neon-core": {
      ".": "5.9.0",
      "lodash": "4.18.1"
    },
    "dompurify": "3.4.16",
    "js-cookie": "3.0.8",
    "postcss": "8.5.28",
    "h3": {
      "defu": "6.1.7"
    },
    "socket.io-parser": "4.2.7",
    "@metamask/utils": {
      "lodash": "4.18.1"
    },
    "xrpl": {
      "lodash": "4.18.1"
    },
    "lodash-es": "4.18.1",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "tinyglobby": {
      "picomatch": "4.0.4",
      "fdir": {
        "picomatch": "4.0.4"
      }
    },
    "stream-json": "3.6.0",
    "uuid": "11.1.1",
    "source-map-js": "1.2.2",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    },
    "mermaid": {
      "katex": "0.18.2"
    }
  }
}
