# === NeoOS Standard .gitignore ===
#
# Directory patterns are deliberately unanchored (no leading "/") so they match
# at every depth: frontend/, sdk/js/, contracts/ and tests/ each produce their
# own dependency, build and tool-state directories. A root-anchored pattern
# such as "/dist/" silently stops protecting sdk/js/dist/.
# scripts/repo_hygiene.test.mjs pins the paths below; run it after any edit.

# Tool State (NEVER commit)
.local/
settings.local.json
.serena/
.planning/
.workbuddy/
.omx/
.worktrees/
graphify-out/
.vercel
.turbo/
# CodeGraph writes a tracked, self-ignoring .codegraph/.gitignore. Ignore the
# rest of every .codegraph/ directory without hiding that file.
**/.codegraph/*
!**/.codegraph/.gitignore

# Build Outputs
target/
dist/
coverage/
.next/
test-results/
*.neopkg
*.wasm

# .NET build outputs
bin/
obj/

# Dependencies
node_modules/

# Environment: every variant (.env, .env.local, .envrc, .env-backup,
# .env_prod, ...) at any depth, except checked-in examples.
.env*
!.env.example

# Secrets
*.pem
*.key
*.p12
id_rsa*
*.gpg

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp
*.log
*.tmp
*.bak
.cache/
/tmp/

# === Repository-Specific Patterns ===

# Test artifacts
tests/.env.testnet
tests/VALIDATION_SUMMARY.md
tests/MIXED_VERIFICATION_PLAN.md
tests/mixed-verification-test.js
tests/run-mixed-verification.js
mainnet-aa-*-results.json

# Automation logs
.automation-logs/

# LaTeX build artifacts
*.aux
*.out
missfont.log
