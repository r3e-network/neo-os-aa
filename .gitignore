# === NeoOS Standard .gitignore ===
#
# Directory patterns are deliberately unanchored (no leading "/") so they match
# at every depth: frontend/, sdk/js/, contracts/ and tests/ each produce their
# own dependency, build and tool-state directories. A root-anchored pattern
# such as "/dist/" silently stops protecting sdk/js/dist/.
# scripts/repo_hygiene.test.mjs pins the paths below; run it after any edit.

# Tool State (NEVER commit)
.local/
settings.local.json
.serena/
.planning/
.workbuddy/
.omx/
.worktrees/
graphify-out/
.vercel
.turbo/
.lia.cache
.nia.cache
.runs/
.codex/
# Formal-refinement closure/scratch working dirs (regenerated on every run)
.work/
.closure-out/
# CodeGraph writes a tracked, self-ignoring .codegraph/.gitignore. Ignore the
# rest of every .codegraph/ directory without hiding that file.
**/.codegraph/*
!**/.codegraph/.gitignore

# Build Outputs
target/
dist/
coverage/
.next/
test-results/
*.neopkg
*.wasm

# .NET build outputs
bin/
obj/
# Plugin-template local verification output (contracts/build/ stays tracked:
# it pins the deployed artifacts, while template builds are reproducible checks)
contracts/plugins/templates/validator/build/
# Isolated NuGet restore cache (README: Restoring with an isolated package cache)
nuget-isolated/
nuget-isolated1/
nuget-isolated-v/

# Python bytecode
__pycache__/

# Dependencies
node_modules/

# Environment: every variant (.env, .env.local, .envrc, .env-backup,
# .env_prod, ...) at any depth, except checked-in examples.
.env*
!.env.example

# Secrets
*.pem
*.key
*.p12
id_rsa*
*.gpg

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp
*.log
*.tmp
*.bak
.cache/
/tmp/

# === Repository-Specific Patterns ===

# Test artifacts
tests/.env.testnet
tests/VALIDATION_SUMMARY.md
tests/MIXED_VERIFICATION_PLAN.md
tests/mixed-verification-test.js
tests/run-mixed-verification.js
mainnet-sa-*-results.json

# Automation logs
.automation-logs/

# LaTeX build artifacts
*.aux
*.out
missfont.log

# Verification reports are local by default. The reviewed SmartAccount evidence
# below is versioned because a guard or a protocol document reads it.
# TESTNET_VALIDATION_SUMMARY.md is generated by the SDK testnet validation
# suite (sdk/js/tests/testnet_validation_suite.mjs) and never reviewed.
docs/TESTNET_VALIDATION_SUMMARY.md
docs/reports/
!docs/reports/
docs/reports/*
!docs/reports/sa-formal-gate-20261031.json
!docs/reports/sa-native-ci-probe-consistency-20261009.json
# The 2026-11-24 current-profile evidence set: 591 tracked files in the ten
# extensions listed here. Only those extensions are versioned; a key, build
# output or local note that a run leaves in this directory stays local-only.
!docs/reports/smartaccount-current-20261124/
docs/reports/smartaccount-current-20261124/**
!docs/reports/smartaccount-current-20261124/**/
!docs/reports/smartaccount-current-20261124/**/*.cs
!docs/reports/smartaccount-current-20261124/**/*.gz
!docs/reports/smartaccount-current-20261124/**/*.json
!docs/reports/smartaccount-current-20261124/**/*.log
!docs/reports/smartaccount-current-20261124/**/*.md
!docs/reports/smartaccount-current-20261124/**/*.nef
!docs/reports/smartaccount-current-20261124/**/*.trx
!docs/reports/smartaccount-current-20261124/**/*.txt
!docs/reports/smartaccount-current-20261124/**/*.v
!docs/reports/smartaccount-current-20261124/**/*.zip
# Build output is never evidence, whatever its extension.
docs/reports/smartaccount-current-20261124/**/[Bb]in/
docs/reports/smartaccount-current-20261124/**/[Oo]bj/
