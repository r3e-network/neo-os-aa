# === NeoOS Standard .gitignore ===
#
# Directory patterns are deliberately unanchored (no leading "/") so they match
# at every depth: frontend/, sdk/js/, contracts/ and tests/ each produce their
# own dependency, build and tool-state directories. A root-anchored pattern
# such as "/dist/" silently stops protecting sdk/js/dist/.
# scripts/repo_hygiene.test.mjs pins the paths below; run it after any edit.

# Tool State (NEVER commit)
.local/
settings.local.json
.serena/
.planning/
.workbuddy/
.omx/
.worktrees/
graphify-out/
.vercel
.turbo/
.lia.cache
.nia.cache
.runs/
.codex/
# CodeGraph writes a tracked, self-ignoring .codegraph/.gitignore. Ignore the
# rest of every .codegraph/ directory without hiding that file.
**/.codegraph/*
!**/.codegraph/.gitignore

# Build Outputs
target/
dist/
coverage/
.next/
test-results/
*.neopkg
*.wasm

# .NET build outputs
bin/
obj/
# Isolated NuGet restore cache (README: Restoring with an isolated package cache)
nuget-isolated/

# Python bytecode
__pycache__/

# Dependencies
node_modules/

# Environment: every variant (.env, .env.local, .envrc, .env-backup,
# .env_prod, ...) at any depth, except checked-in examples.
.env*
!.env.example

# Secrets
*.pem
*.key
*.p12
id_rsa*
*.gpg

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp
*.log
*.tmp
*.bak
.cache/
/tmp/

# === Repository-Specific Patterns ===

# Test artifacts
tests/.env.testnet
tests/VALIDATION_SUMMARY.md
tests/MIXED_VERIFICATION_PLAN.md
tests/mixed-verification-test.js
tests/run-mixed-verification.js
mainnet-aa-*-results.json

# Automation logs
.automation-logs/

# LaTeX build artifacts
*.aux
*.out
missfont.log

# Verification reports are local by default. The explicitly reviewed
# SmartAccount evidence below is versioned because protocol documents cite it.
docs/reports/
!docs/reports/
docs/reports/*
!docs/reports/aa-artifact-reproducibility-20261025.json
!docs/reports/aa-neoexpress-validation-20261025.json
!docs/reports/aa-private-artifact-provenance-20261025.json
!docs/reports/aa-artifact-reproducibility-20261030.json
!docs/reports/aa-artifact-reproducibility-20261031.json
!docs/reports/aa-artifact-reproducibility-20261113.json
!docs/reports/aa-closure-gate-20261031.json
!docs/reports/aa-formal-gate-20261030.json
!docs/reports/aa-formal-gate-20261031.json
!docs/reports/aa-neoexpress-validation-20261030.json
!docs/reports/aa-neoexpress-validation-20261031.json
!docs/reports/aa-private-artifact-provenance-20261030.json
!docs/reports/aa-private-artifact-provenance-20261031.json
!docs/reports/aa-ordinary-candidate-compatibility-20261030.json
!docs/reports/aa-ordinary-candidate-compatibility-20261113.json
!docs/reports/aa-native-ci-probe-consistency-20261009.json
!docs/reports/testnet-validation-v1v2-2026-03.md
!docs/reports/native-domain-copy-20261009/
docs/reports/native-domain-copy-20261009/*
!docs/reports/native-domain-copy-20261009/*.json
!docs/reports/native-usability-20261009/
docs/reports/native-usability-20261009/*
!docs/reports/native-usability-20261009/*.json
!docs/reports/smartaccount-native-module-build-20261030-authority.json
!docs/reports/smartaccount-native-runner-build-20261030-authority2.json
