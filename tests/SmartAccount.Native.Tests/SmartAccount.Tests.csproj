<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Neo.UnitTests</AssemblyName>
    <RootNamespace>Neo.UnitTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <AnalysisLevel>latest</AnalysisLevel>
    <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
    <NeoTestsRoot Condition="'$(NeoTestsRoot)' == ''">$(MSBuildThisFileDirectory)../../../neo-native-core/tests/Neo.UnitTests</NeoTestsRoot>
    <NeoSourceRoot Condition="'$(NeoSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../../neo-native-core/src</NeoSourceRoot>
  </PropertyGroup>

  <!-- Like the core project, the test project compiles the pinned core's full
       test tree and swaps in the SA-owned copies of the SmartAccount UT files
       that live in this directory, so the whole SmartAccount test surface lives
       here. NeoTestsRoot / NeoSourceRoot are regular MSBuild properties and can
       be overridden by environment variables of the same name. -->
  <ItemGroup>
    <Compile Include="$(NeoTestsRoot)/**/*.cs"
             Exclude="$(NeoTestsRoot)/obj/**;$(NeoTestsRoot)/bin/**;$(NeoTestsRoot)/SmartContract/Native/UT_SmartAccount*.cs;$(NeoTestsRoot)/SmartContract/Native/SmartAccountTestSupport.cs" />
    <Compile Include="*.cs" />
    <Compile Include="Integration/*.cs" Condition="'$(StandardModuleNefDir)' != ''" />
    <None Include="$(StandardModuleNefDir)/*.nef;$(StandardModuleNefDir)/*.manifest.json"
          Condition="'$(StandardModuleNefDir)' != ''"
          Link="StandardModules/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="$(NeoTestsRoot)/../AssemblyInfo.cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NeoTestsRoot)/SmartContract/Manifest/TestFile/**/*" Link="SmartContract/Manifest/TestFile/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The core's own SmartAccount fixtures are copied in as-is; the v4
         vectors this project pins live in TestFile/smartaccount-v4-vectors.json
         and are derived by TestFile/generate-smartaccount-v4-vectors.py. -->
    <None Include="$(NeoTestsRoot)/SmartContract/Native/TestFile/**/*"
          Link="SmartContract/Native/TestFile/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestFile/**/*" Link="SmartContract/Native/TestFile/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NeoTestsRoot)/GasTests/Fixtures/**/*" Link="GasTests/Fixtures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NeoTestsRoot)/test.config.json" Link="test.config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka.TestKit" Version="1.5.70" />
    <PackageReference Include="Akka.TestKit.MSTest" Version="1.5.67" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest" Version="4.3.2" />
    <PackageReference Include="Namotion.Reflection" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../contracts/native/Neo.csproj" />
    <ProjectReference Include="$(NeoSourceRoot)/Neo.Extensions/Neo.Extensions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../fixtures/sa-module-protocol/module-profile-vectors.json" Link="module-profile-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/native-smartaccount.manifest.json" Link="native-smartaccount.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
