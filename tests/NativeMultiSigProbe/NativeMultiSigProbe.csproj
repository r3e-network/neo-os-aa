<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <NuGetAudit>false</NuGetAudit>
    <RestoreSources></RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(NativeRuntimeDirectory)/*.dll" />
  </ItemGroup>
  <Target Name="RequireNativeRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="'$(NativeRuntimeDirectory)' == '' Or !Exists('$(NativeRuntimeDirectory)/Neo.dll')"
           Text="An explicit, validated source-built NativeRuntimeDirectory is required." />
  </Target>
</Project>
