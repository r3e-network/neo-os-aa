<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Test double; the suite drives nccs through the harness. -->
    <RunNccsAfterBuild>false</RunNccsAfterBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Neo.SmartContract.Framework" Version="$(NeoSmartContractFrameworkVersion)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="MockModuleCore.cs" />
  </ItemGroup>
  <Target Name="CompileSmartContract" AfterTargets="Build" Condition="'$(RunNccsAfterBuild)' == 'true'">
    <Message Text="Compiling Neo smart contract: MockModuleCore.cs" Importance="high" />
    <Exec Command="nccs ./MockModuleCore.csproj -o ../../artifacts/mock" WorkingDirectory="$(ProjectDir)" />
  </Target>
</Project>
