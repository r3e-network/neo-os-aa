<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RunNccsAfterBuild>false</RunNccsAfterBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Neo.SmartContract.Framework" Version="$(NeoSmartContractFrameworkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="SmartAccount.cs" />
    <Compile Include="SmartAccount.ModuleProtocol.cs" />
    <Compile Include="SmartAccount.Models.cs" />
    <Compile Include="SmartAccount.Modules.cs" />
    <Compile Include="SmartAccount.Intents.cs" />
    <Compile Include="SmartAccount.Nonce.cs" />
    <Compile Include="SmartAccount.Message.cs" />
    <Compile Include="SmartAccount.Internal.cs" />
    <Compile Include="SmartAccount.Events.cs" />
    <Compile Include="SmartAccount.Accounts.cs" />
    <Compile Include="SmartAccount.Migration.cs" />
    <Compile Include="SmartAccount.PlatformRegistrar.cs" />
    <Compile Include="SmartAccount.Proxy.cs" />
    <Compile Include="SmartAccount.State.cs" />
    <Compile Include="SmartAccount.Execution.cs" />
    <Compile Include="SmartAccount.VerifyContext.cs" />
    <Compile Include="SmartAccount.Escape.cs" />
    <Compile Include="SmartAccount.MarketEscrow.cs" />
    <Compile Include="SmartAccount.Admin.cs" />
    <Compile Include="SmartAccount.Paymaster.cs" />
  </ItemGroup>

  <Target Name="CompileSmartContract" AfterTargets="Build" Condition="'$(RunNccsAfterBuild)' == 'true'">
    <Message Text="Compiling Neo smart contract: SmartAccount.cs" Importance="high" />
    <Exec Command="nccs ./SmartAccount.csproj -o bin/v3" WorkingDirectory="$(ProjectDir)" />
  </Target>

</Project>
