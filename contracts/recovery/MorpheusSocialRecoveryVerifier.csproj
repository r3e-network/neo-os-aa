<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SocialRecoveryVerifier</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Explicit source inputs: rebuild the NEF and manifest after semantic changes. -->
    <Compile Include="MorpheusSocialRecoveryVerifier.ActionAuthorization.cs" />
    <Compile Include="MorpheusSocialRecoveryVerifier.Fixed.cs" />
    <Compile Include="MorpheusSocialRecoveryVerifier.Flows.cs" />
    <Compile Include="MorpheusSocialRecoveryVerifier.Lifecycle.cs" />
    <Compile Include="MorpheusSocialRecoveryVerifier.Queries.cs" />
    <Compile Include="MorpheusSocialRecoveryVerifier.Storage.cs" />
    <Compile Include="MorpheusSocialRecoveryVerifier.Validation.cs" />
    <Compile Include="MorpheusSocialRecoveryVerifier.V3.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Neo.SmartContract.Framework" Version="$(NeoSmartContractFrameworkVersion)" />
  </ItemGroup>
</Project>
