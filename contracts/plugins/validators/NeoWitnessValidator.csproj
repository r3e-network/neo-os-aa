<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RunNccsAfterBuild>false</RunNccsAfterBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Neo.SmartContract.Framework" Version="$(NeoSmartContractFrameworkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ValidatorAuthority.cs" />
    <Compile Include="ModuleOperation.cs" />
    <Compile Include="ValidatorPayload.cs" />
    <Compile Include="ValidatorModels.cs" />
    <Compile Include="SignerDomain.cs" />
    <Compile Include="ValidatorClock.cs" />
    <Compile Include="NeoWitnessValidator.cs" />
  </ItemGroup>

  <Target Name="CompileSmartContract" AfterTargets="Build" Condition="'$(RunNccsAfterBuild)' == 'true'">
    <Message Text="Compiling Neo smart contract: NeoWitnessValidator.cs" Importance="high" />
    <Exec Command="nccs ./NeoWitnessValidator.csproj -o ../../bin/public/validators" WorkingDirectory="$(ProjectDir)" />
  </Target>

</Project>
