<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- A module skeleton is a library until its owner decides to emit a NEF. -->
    <RunNccsAfterBuild>false</RunNccsAfterBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Neo.SmartContract.Framework" Version="$(NeoSmartContractFrameworkVersion)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/ModuleSupport.cs" />
    <Compile Include="RecoveryModule.cs" />
  </ItemGroup>
  <Target Name="CompileSmartContract" AfterTargets="Build" Condition="'$(RunNccsAfterBuild)' == 'true'">
    <Message Text="Compiling Neo smart contract: RecoveryModule.cs" Importance="high" />
    <Exec Command="nccs ./RecoveryModule.csproj -o ../../bin/public/modules" WorkingDirectory="$(ProjectDir)" />
  </Target>
</Project>
