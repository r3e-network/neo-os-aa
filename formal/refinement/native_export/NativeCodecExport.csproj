<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompilerToolDirectory Condition="'$(CompilerToolDirectory)' == ''">$(HOME)/.dotnet/tools/.store/neo.compiler.csharp/3.9.1/neo.compiler.csharp/3.9.1/tools/net10.0/any</CompilerToolDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(CompilerToolDirectory)/Microsoft.CodeAnalysis.dll"><Private>true</Private></Reference>
    <Reference Include="$(CompilerToolDirectory)/Microsoft.CodeAnalysis.CSharp.dll"><Private>true</Private></Reference>
  </ItemGroup>
</Project>
