<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <CompilerToolDirectory Condition="'$(CompilerToolDirectory)' == ''">$(HOME)/.dotnet/tools/.store/neo.compiler.csharp/3.9.1/neo.compiler.csharp/3.9.1/tools/net10.0/any</CompilerToolDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(CompilerToolDirectory)/*.dll" Exclude="$(CompilerToolDirectory)/ReportGenerator*.dll;$(CompilerToolDirectory)/McMaster.NETCore.Plugins.dll"><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="RequirePinnedCompiler" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(CompilerToolDirectory)/nccs.dll')" Text="Set CompilerToolDirectory to the installed audited NCCS 3.9.1 tools/net10.0/any directory." />
  </Target>
</Project>
