{
  "name": "neo-abstract-account",
  "version": "1.0.0",
  "description": "Neo N3 Abstract Account SDK",
  "license": "MIT",
  "main": "dist/sdk/js/src/index.js",
  "types": "dist/sdk/js/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/js/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/sdk/js/src/index.js",
      "default": "./dist/sdk/js/src/index.js"
    }
  },
  "homepage": "https://github.com/r3e-network/neo-os-aa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r3e-network/neo-os-aa.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "PACKAGING.md"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "prepack": "npm run build",
    "test": "node --test tests/*.unit.test.js",
    "test:package": "node --test tests/package-consumer.test.js",
    "types:check": "tsc --noEmit --project tsconfig.types.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "testnet:validate": "./run_testnet_validation_suite.sh",
    "testnet:validate:dry-run": "./run_testnet_validation_suite.sh --dry-run",
    "testnet:validate:report": "./run_testnet_validation_suite.sh",
    "testnet:validate:smoke": "node tests/v3_testnet_smoke.js",
    "testnet:validate:plugin-matrix": "node tests/v3_testnet_plugin_matrix.js",
    "testnet:validate:market": "node tests/v3_testnet_market_escrow.js",
    "testnet:validate:paymaster-policy": "node tests/v3_testnet_paymaster_policy.mjs",
    "testnet:validate:paymaster": "node tests/v3_testnet_paymaster_relay.mjs",
    "testnet:validate:paymaster-onchain": "node tests/v3_testnet_paymaster_onchain.mjs",
    "mainnet:validate:readonly": "node tests/v3_mainnet_readonly.mjs",
    "mainnet:deploy:market-paymaster": "node ../../scripts/deploy_mainnet_market_paymaster.js"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@cityofzion/neon-js": "^5.10.1",
    "typescript": "^5.4.5"
  }
}
