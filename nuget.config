<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    nuget.org is the only package source and every package id maps to it, so no other feed
    (a developer's user-level source, a private feed, a local folder) can supply a package for
    this repository, and each clear element also drops what a parent or user-level NuGet.Config
    would add. Adding a source means mapping the exact package ids it may serve.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
