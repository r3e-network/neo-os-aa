# Unified diff blank context lines contain a required literal space. Preserve
# the byte-exact compatibility patch consumed by the source-runner build.
scripts/neoexpress-build-compat.patch whitespace=-blank-at-eol

# Generated Morpheus mirrors must stay LF on every checkout: the canonical
# sync gate compares them byte-for-byte with the neo-os-services export.
frontend/src/utils/morpheusConfidentialEnvelope.generated.js text eol=lf
frontend/src/config/generatedMorpheusRegistry.js text eol=lf
frontend/src/config/generatedMorpheusRuntimeCatalog.js text eol=lf
